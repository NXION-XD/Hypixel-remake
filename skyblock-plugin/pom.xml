<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.corot2b</groupId>
    <artifactId>skyblock-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>skyblock-plugin</artifactId>
  <name>SkyBlock :: Distribution</name>
  <description>Assembles every module into a single Paper plugin jar.</description>

  <dependencies>
    <dependency><groupId>com.corot2b</groupId><artifactId>skyblock-core</artifactId></dependency>
    <dependency><groupId>com.corot2b</groupId><artifactId>skyblock-economy</artifactId></dependency>
    <dependency><groupId>com.corot2b</groupId><artifactId>skyblock-gameplay</artifactId></dependency>
    <dependency><groupId>com.corot2b</groupId><artifactId>skyblock-dungeons</artifactId></dependency>
    <dependency><groupId>com.corot2b</groupId><artifactId>skyblock-gui</artifactId></dependency>
    <dependency><groupId>com.corot2b</groupId><artifactId>skyblock-webapi</artifactId></dependency>
  </dependencies>

  <build>
    <finalName>SkyBlock-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <minimizeJar>false</minimizeJar>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <relocations>
                <relocation><pattern>com.zaxxer.hikari</pattern><shadedPattern>com.corot2b.libs.hikari</shadedPattern></relocation>
                <relocation><pattern>redis.clients</pattern><shadedPattern>com.corot2b.libs.jedis</shadedPattern></relocation>
                <relocation><pattern>io.javalin</pattern><shadedPattern>com.corot2b.libs.javalin</shadedPattern></relocation>
                <relocation><pattern>org.postgresql</pattern><shadedPattern>com.corot2b.libs.postgres</shadedPattern></relocation>
                <relocation><pattern>com.mysql</pattern><shadedPattern>com.corot2b.libs.mysql</shadedPattern></relocation>
              </relocations>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
  </build>
</project>
